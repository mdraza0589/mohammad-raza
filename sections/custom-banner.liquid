<div class="custom-banner">
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.subheading }}</p>
  <a href="{{ section.settings.button_link }}" class="banner-btn">
    {{ section.settings.button_text }}
  </a>
</div>

<style>
.custom-banner {
  text-align: center;
  padding: 80px 20px;
}

.banner-btn {
  background: black;
  color: white;
  padding: 12px 24px;
  text-decoration: none;
  transition: 0.3s;
}

.banner-btn:hover {
  background: #444;
}
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Banner Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Banner Subheading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}


