<section class="gift-banner" style="background-image: url({{ section.settings.bg_image | image_url }});">
  <div class="gift-banner__content">
    
    {% if section.settings.heading != blank %}
      <h1 class="gift-banner__title">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="gift-banner__text">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link }}" class="gift-banner__btn">
        {{ section.settings.button_text }}
        <span class="arrow">→</span>
      </a>
    {% endif %}

  </div>
</section>

<style>
/* ===== Banner Layout ===== */
.gift-banner {
  width: 100%;
  min-height: 520px;
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
}

.gift-banner__content {
  max-width: 500px;
  margin-left: 80px;
}

/* ===== Text Styles ===== */
.gift-banner__title {
  font-size: 48px;
  font-weight: 600;
  margin-bottom: 20px;
}

.gift-banner__text {
  font-size: 16px;
  line-height: 1.6;
  margin-bottom: 30px;
  color: #333;
}

/* ===== Button ===== */
.gift-banner__btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: #000;
  color: #fff;
  padding: 14px 28px;
  text-decoration: none;
  font-size: 14px;
  transition: all 0.3s ease;
}

.gift-banner__btn:hover {
  background: #333;
  transform: translateX(4px);
}

/* ===== Mobile ===== */
@media (max-width: 768px) {
  .gift-banner {
    min-height: 420px;
  }

  .gift-banner__content {
    margin: 40px 20px;
  }

  .gift-banner__title {
    font-size: 32px;
  }
}
</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts for your loved ones."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}
